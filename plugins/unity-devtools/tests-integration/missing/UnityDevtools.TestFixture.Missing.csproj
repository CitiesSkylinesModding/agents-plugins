<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The dependency that is absent at run time: the Broken assembly beside it compiles against this
    one and ships without it, which is what makes the types deriving from it fail to load while the
    rest of that assembly loads fine.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>TestFixture.Missing</RootNamespace>
    <AssemblyName>UnityDevtools.TestFixture.Missing</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.NETFramework.ReferenceAssemblies"
      Version="1.0.3"
      PrivateAssets="all" />
  </ItemGroup>
</Project>

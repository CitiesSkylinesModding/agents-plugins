<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline test suite: the C# expression evaluator in sdb/Eval (parser/AST coverage and client-side
    primitive operator semantics), and the other pure functions worth pinning, such as the
    PlayerConnection beacon parser.
    Anything touching a live VM or a socket is out of scope here and is covered by the
    tests-integration suite instead.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>UnityDevtools.Sdb.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../sdb/UnityDevtools.Sdb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>

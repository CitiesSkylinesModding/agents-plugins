{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The benchmark runs under Bun and nowhere else: bun:test and Bun.spawn need these types, and
    // they carry the Node ones with them, which is why the node: builtins here still resolve.
    "types": ["bun"]
  },
  // The root config's include resolves relative to the root; scope this project to the benchmark.
  // A task's samples and a run's collected files are mod sources, written against the game's
  // assemblies and UI scaffold, so they sit outside the program.
  "include": ["**/*.ts"],
  "exclude": ["tasks", "results"]
}
